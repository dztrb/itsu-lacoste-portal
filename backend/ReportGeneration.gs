/**
 * ITSU LACOSTE VERIFICATION & COLLECTION PORTAL
 * Report Generation Module
 * Takoradi Technical University - Department of Computer Science
 */

const REPORT_TYPES = {
  COMPLETE_REGISTER: 'COMPLETE_REGISTER',
  BLUE_LACOSTE_LIST: 'BLUE_LACOSTE_LIST',
  WHITE_LACOSTE_LIST: 'WHITE_LACOSTE_LIST',
  SIZE_DISTRIBUTION: 'SIZE_DISTRIBUTION',
  COLOUR_SIZE_BREAKDOWN: 'COLOUR_SIZE_BREAKDOWN',
  PENDING_STUDENTS: 'PENDING_STUDENTS',
  OVERALL_SUMMARY: 'OVERALL_SUMMARY'
};

/**
 * Generates structured report payload for download
 * @param {string} sessionToken - Validated Treasurer session token
 * @param {string} reportType - One of REPORT_TYPES
 * @param {string} format - 'xlsx', 'docx', 'pdf', 'csv'
 */
function exportReport(sessionToken, reportType, format) {
  const session = validateAdminSession(sessionToken);

  const students = getRowsAsObjects(SHEET_NAMES.STUDENTS);
  const selections = getRowsAsObjects(SHEET_NAMES.SELECTIONS);
  const now = new Date();
  const generatedAt = Utilities.formatDate(now, 'GMT', "yyyy-MM-dd HH:mm:ss 'GMT'");

  let title = '';
  let headers = [];
  let rows = [];
  let summary = {};

  switch (reportType) {
    case REPORT_TYPES.COMPLETE_REGISTER:
      title = 'Complete Student Selection Register';
      headers = ['#', 'Submission ID', 'Full Name', 'Index Number', 'Colour', 'Size', 'Submitted At', 'Status'];
      rows = selections.map((s, idx) => [
        idx + 1,
        s['Submission ID'],
        s['Full Name'],
        s['Index Number'],
        s['Selected Colour'],
        s['Selected Size'],
        s['Submitted At'],
        s['Submission Status']
      ]);
      summary = {
        'Total Selections': selections.length,
        'Generated By': session.email
      };
      break;

    case REPORT_TYPES.BLUE_LACOSTE_LIST:
      title = 'Blue Lacoste Selections List';
      headers = ['#', 'Submission ID', 'Full Name', 'Index Number', 'Size', 'Submitted At'];
      const blueList = selections.filter(s => normalizeText(s['Selected Colour']).toLowerCase() === 'blue');
      rows = blueList.map((s, idx) => [
        idx + 1,
        s['Submission ID'],
        s['Full Name'],
        s['Index Number'],
        s['Selected Size'],
        s['Submitted At']
      ]);
      summary = {
        'Colour': 'Blue',
        'Total Blue Orders': blueList.length,
        'Percentage of Total': selections.length > 0 ? Math.round((blueList.length / selections.length) * 100) + '%' : '0%'
      };
      break;

    case REPORT_TYPES.WHITE_LACOSTE_LIST:
      title = 'White Lacoste Selections List';
      headers = ['#', 'Submission ID', 'Full Name', 'Index Number', 'Size', 'Submitted At'];
      const whiteList = selections.filter(s => normalizeText(s['Selected Colour']).toLowerCase() === 'white');
      rows = whiteList.map((s, idx) => [
        idx + 1,
        s['Submission ID'],
        s['Full Name'],
        s['Index Number'],
        s['Selected Size'],
        s['Submitted At']
      ]);
      summary = {
        'Colour': 'White',
        'Total White Orders': whiteList.length,
        'Percentage of Total': selections.length > 0 ? Math.round((whiteList.length / selections.length) * 100) + '%' : '0%'
      };
      break;

    case REPORT_TYPES.SIZE_DISTRIBUTION:
      title = 'Size Distribution Report';
      headers = ['Size', 'Total Count', 'Percentage of Total'];
      const sizeSizes = ['S', 'M', 'L', 'XL', 'XXL', 'XXXL'];
      const totalSels = selections.length;
      rows = sizeSizes.map(sz => {
        const count = selections.filter(s => normalizeText(s['Selected Size']).toUpperCase() === sz).length;
        const pct = totalSels > 0 ? Math.round((count / totalSels) * 100) + '%' : '0%';
        return [sz, count, pct];
      });
      summary = {
        'Total Submissions Evaluated': totalSels
      };
      break;

    case REPORT_TYPES.COLOUR_SIZE_BREAKDOWN:
      title = 'Colour and Size Cross-Tabulation Matrix';
      headers = ['Size', 'Blue', 'White', 'Total Order'];
      const sizesList = ['S', 'M', 'L', 'XL', 'XXL', 'XXXL'];
      let grandBlue = 0;
      let grandWhite = 0;
      rows = sizesList.map(sz => {
        const blueC = selections.filter(s => normalizeText(s['Selected Size']).toUpperCase() === sz && normalizeText(s['Selected Colour']).toLowerCase() === 'blue').length;
        const whiteC = selections.filter(s => normalizeText(s['Selected Size']).toUpperCase() === sz && normalizeText(s['Selected Colour']).toLowerCase() === 'white').length;
        grandBlue += blueC;
        grandWhite += whiteC;
        return [sz, blueC, whiteC, blueC + whiteC];
      });
      // Add Totals row
      rows.push(['GRAND TOTAL', grandBlue, grandWhite, grandBlue + grandWhite]);
      summary = {
        'Total Units': grandBlue + grandWhite,
        'Blue Total': grandBlue,
        'White Total': grandWhite
      };
      break;

    case REPORT_TYPES.PENDING_STUDENTS:
      title = 'Pending Students Register (Unsubmitted Pre-Ordered Students)';
      headers = ['#', 'Full Name', 'Index Number', 'Status', 'Date Added'];
      const submittedIdxSet = new Set(selections.map(s => normalizeIndexNumber(s['Index Number'])));
      const pendingList = students.filter(s => {
        return normalizeText(s['Payment Status']).toUpperCase() === 'PAID' &&
               !submittedIdxSet.has(normalizeIndexNumber(s['Index Number']));
      });
      rows = pendingList.map((p, idx) => [
        idx + 1,
        p['Full Name'],
        p['Index Number'],
        p['Payment Status'],
        p['Date Added']
      ]);
      summary = {
        'Total Pending Students': pendingList.length,
        'Status': 'Awaiting Student Preference Selection'
      };
      break;

    case REPORT_TYPES.OVERALL_SUMMARY:
    default:
      title = 'Overall Lacoste Collection Executive Summary';
      headers = ['Metric Category', 'Metric Name', 'Count / Value'];
      const paidSts = students.filter(s => normalizeText(s['Payment Status']).toUpperCase() === 'PAID');
      const bCount = selections.filter(s => normalizeText(s['Selected Colour']).toLowerCase() === 'blue').length;
      const wCount = selections.filter(s => normalizeText(s['Selected Colour']).toLowerCase() === 'white').length;
      const compPct = paidSts.length > 0 ? Math.round((selections.length / paidSts.length) * 100) + '%' : '0%';
      
      rows = [
        ['Enrollment & Dues', 'Total Registered Students', students.length],
        ['Enrollment & Dues', 'Total Paid Eligible Students', paidSts.length],
        ['Collection Progress', 'Total Confirmed Selections', selections.length],
        ['Collection Progress', 'Total Pending Paid Students', Math.max(0, paidSts.length - selections.length)],
        ['Collection Progress', 'Completion Percentage', compPct],
        ['Colour Preferences', 'Blue Lacoste Count', bCount],
        ['Colour Preferences', 'White Lacoste Count', wCount],
        ['Colour Preferences', 'Blue Ratio', selections.length > 0 ? Math.round((bCount / selections.length) * 100) + '%' : '0%'],
        ['Colour Preferences', 'White Ratio', selections.length > 0 ? Math.round((wCount / selections.length) * 100) + '%' : '0%']
      ];
      summary = {
        'Institution': 'Takoradi Technical University',
        'Department': 'Department of Computer Science',
        'Union': 'Information Technology Students Union (ITSU)'
      };
      break;
  }

  logAudit(session.email, 'REPORT_EXPORTED', { reportType, format }, 'SUCCESS');

  return {
    reportType: reportType,
    title: title,
    institution: 'Takoradi Technical University',
    department: 'Department of Computer Science',
    union: 'Information Technology Students Union (ITSU)',
    generatedAt: generatedAt,
    generatedBy: session.email,
    summary: summary,
    headers: headers,
    rows: rows
  };
}

